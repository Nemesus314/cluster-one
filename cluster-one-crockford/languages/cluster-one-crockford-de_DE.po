msgstr ""
"Schlüsseltresor aktiv — jede Identität bringt ihren eigenen Schlüssel mit"

#: includes/kern.php:2871
msgid "Database (Connectors screen)"
msgstr "Datenbank (Connectors-Screen)"

#: includes/kern.php:2873
msgid "no key yet"
msgstr "noch kein Key"

#: includes/kern.php:2958
msgid "Unregistered user"
msgstr "Unregistrierter Nutzer"

#: includes/kern.php:3082
msgid "Cluster One"
msgstr "Cluster One"

#: includes/kern.php:3104
#, php-format
msgid ""
"Cluster One: %d records were anonymised. The entries themselves remain — the "
"node keeps a record that something was written, not who wrote it. Anything "
"that travelled to other nodes has to be erased there."
msgstr ""
"Cluster One: %d Datensätze wurden anonymisiert. Die Einträge selbst bleiben "
"stehen — der Knoten hält fest, DASS geschrieben wurde, nicht von wem. Was zu "
"anderen Knoten gereist ist, muss dort gelöscht werden."

#: includes/kern.php:3878
#, php-format
msgid "The operator of this node gave this address on %2$s: %1$s"
msgstr "Der Betreiber dieses Knotens gab diese Adresse am %2$s an: %1$s"

#: includes/kern.php:3885
msgid "Write an e-mail to that node’s operator"
msgstr "Dem Betreiber dieses Knotens eine Mail schreiben"

