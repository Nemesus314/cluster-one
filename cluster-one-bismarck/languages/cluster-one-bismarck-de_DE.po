msgstr "Veröffentlicht"

#: includes/bismarck-seiten.php:195 includes/platon.php:4071
msgid "Pin — stays on top in every view"
msgstr "Anheften — steht in jeder Ansicht oben"

#: includes/bismarck-seiten.php:195 includes/bismarck-seiten.php:196
#: includes/platon.php:4071 includes/platon.php:4072
