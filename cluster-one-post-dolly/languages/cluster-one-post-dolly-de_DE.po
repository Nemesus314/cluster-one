#: includes/cluster-one-post-dolly.php
msgid "Quote proposed"
msgstr "Zitat vorgeschlagen"

#: includes/cluster-one-post-dolly.php
msgid "Quote proposal withdrawn"
msgstr "Zitat-Vorschlag zurückgezogen"

#: includes/cluster-one-post-dolly.php
msgid "Quote proposal accepted into the table"
msgstr "Zitat-Vorschlag in die Tabelle übernommen"

#: includes/cluster-one-post-dolly.php
msgid "Quote proposal rejected"
msgstr "Zitat-Vorschlag abgelehnt"

#: includes/cluster-one-post-dolly.php
msgid "Quote proposal back to open"
msgstr "Zitat-Vorschlag zurück auf offen"

